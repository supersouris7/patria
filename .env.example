APP_PASSWORD=remplacer-par-un-mot-de-passe-long
# Utilisateurs publics : stable apres publication du premier tag vX.Y.Z.
# Sans cette variable, le Compose conserve unstable pour l'installation de developpement.
# PATRIA_IMAGE=supersouris7/patria:latest
# AVANT le premier lancement : generer et conserver la cle, puis decommenter la ligne ci-dessous.
# Sans cle au premier lancement, les bases restent EN CLAIR. Voir docs/administration.md.
# openssl rand -base64 32
# Garder la cle separement des sauvegardes : perdue, les bases chiffrees sont irrecuperables.
# Cle absente apres activation : remettre la cle D'ORIGINE, ne pas en generer une autre.
# DB_ENCRYPTION_KEY=
# Identifiant de l'administrateur (facultatif, admin par defaut)
# ADMIN_LOGIN=admin
# Aucun appel automatique externe (prix du marche, taux, localisation des IP)
# OFFLINE=true
DATABASE_PATH=/data/immobilier.sqlite3
PORT=8101
# Lien « Soutenir Patria » (Ko-fi) du pied de page ; vide : masque
# Par defaut : https://ko-fi.com/supersouris7 ; vide pour masquer le lien
# KOFI_URL=
# Telephone perdu : retire la double authentification de l'administrateur au demarrage, puis retirer la ligne
# ADMIN_2FA_RESET=true

