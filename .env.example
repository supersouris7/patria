APP_PASSWORD=remplacer-par-un-mot-de-passe-long
# Identifiant de l'administrateur (facultatif, admin par defaut)
# ADMIN_LOGIN=admin
# Aucun appel externe (prix du marche, taux) : l'adresse des biens ne quitte pas le serveur
# OFFLINE=true
DATABASE_PATH=/data/immobilier.sqlite3
PORT=8101
# Chiffrement des bases (16 caracteres au moins) : openssl rand -base64 32
# Sans cette cle, les bases chiffrees sont illisibles : gardez-la en lieu sur, a part des sauvegardes.
# DB_ENCRYPTION_KEY=
# Lien « Soutenir Patria » (Ko-fi) du pied de page ; vide : masque
# KOFI_URL=https://ko-fi.com/votre-nom
